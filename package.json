{
  "name": "interactive-portfolio-playtest",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "qa": "npm run build && node scripts/qa.mjs",
    "qa:pinch": "npm run build && node scripts/qa-pinch.mjs",
    "qa:sprites": "npm run build && node scripts/qa-sprites.mjs",
    "qa:smoke": "npm run build && node scripts/qa-smoke.mjs",
    "qa:gate": "npm run build && npm run typecheck && node scripts/check-logos.mjs && node scripts/qa-sprites.mjs && node scripts/qa-smoke.mjs",
    "check:logos": "node scripts/check-logos.mjs",
    "deploy:gh-pages": "node scripts/deploy-gh-pages.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "pixi.js": "^8.14.0"
  }
}
